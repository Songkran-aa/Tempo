# ---- Production (docker compose) ----
DOMAIN=tempo.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
APP_REPLICAS=2
DB_POOL_MAX=20
# 0 = only admin-created accounts (server/scripts/create-user.js) and invited emails can sign up
ALLOW_SIGNUP=0
SESSION_DAYS=30

# ---- Email notifications (optional) ----
# Without SMTP_URL, notifications are in-app only. Examples:
#   SMTP_URL=smtps://apikey:SECRET@smtp.sendgrid.net:465
#   SMTP_URL=smtp://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:587
# SMTP_URL=
# MAIL_FROM=Tempo <no-reply@example.com>
# APP_URL=https://tempo.example.com   (defaults to https://DOMAIN)

# ---- Database name/user (default: tempo) ----
# POSTGRES_USER=tempo
# POSTGRES_DB=tempo

# ---- Running without Docker ----
# DATABASE_URL=postgres://user:pass@host:5432/tempo
# DB_SSL=1  (managed Postgres that requires SSL)
# PORT=3000
# NODE_ENV=production
# Leave DATABASE_URL empty for local development: an embedded database (PGlite) is stored in ./data

# ---- Behind your own reverse proxy / tunnel (no Caddy) ----
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.port.yml
# APP_PORT=3100
# APP_REPLICAS=1
